{
	"name": "eizport-site",
	"version": "1.0.0",
	"private": true,
	"description": "Eizport: product site, docs, brand and design system (Astro, GitHub Pages).",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && node scripts/check-screenshots.mjs && node scripts/translations.mjs --status",
		"brand": "node scripts/brand.mjs",
		"lighthouse": "node scripts/lighthouse.mjs",
		"demo-sites": "bash scripts/demo-sites.sh",
		"screenshots": "node scripts/screenshots.mjs",
		"check:screenshots": "node scripts/check-screenshots.mjs",
		"video": "node scripts/video.mjs",
		"translations": "node scripts/translations.mjs",
		"media": "node scripts/media.mjs",
		"plugin-languages": "node scripts/plugin-languages.mjs"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/inter": "5.3.0",
		"@wordpress/base-styles": "13.3.0",
		"astro": "7.3.5",
		"qrcode": "1.5.4",
		"sass": "1.105.1",
		"sharp": "0.35.5",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@fontsource/inter": "5.3.0",
		"@types/qrcode": "1.5.6",
		"ffmpeg-static": "5.2.0",
		"lighthouse": "13.5.0",
		"opentype.js": "2.0.0",
		"playwright": "1.56.1"
	}
}
